{
  "crons": [
    {
      "path": "/api/admin/pricing-audit",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "villa-sicile.vercel.app" }],
      "destination": "https://www.villavenusnoto.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "villavenusnoto.com" }],
      "destination": "https://www.villavenusnoto.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
